{
  "name": "xinspect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "xinspect": "./dist/src/cli.js" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "web": "npm run build && node dist/src/web.js",
    "test": "npm run build && node dist/test/run.js",
    "test:browser": "npm run build && node dist/test/browser.test.js",
    "refresh:reports": "npm run build && node scripts/refresh-reports.mjs",
    "analyze": "npm run build && node dist/src/cli.js",
    "package:examples": "node scripts/package-examples.mjs"
  },
  "dependencies": {
    "@babel/parser": "7.29.8",
    "@babel/traverse": "7.29.8",
    "jszip": "3.10.1",
    "htmlparser2": "10.1.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "7.28.0",
    "@types/node": "26.6.4",
    "typescript": "5.9.3"
  }
}
